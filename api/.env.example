# Copie para .env e preencha. NUNCA versione o .env.

# --- Domínio público da API (subdomínio + domínio, sem https://) ---
API_DOMAIN=

# --- Túnel Cloudflare ---
CLOUDFLARE_TOKEN=

# --- OpenAI: recebe os textos das fotos numa única chamada e escreve resumo/tópicos/assuntos ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# --- Notion: integração PÚBLICA (portal de integrações do Notion) ---
# Redirect URI a cadastrar no portal: https://<API_DOMAIN>/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# --- Login com Google (Supabase Auth) ---
# ID do cliente OAuth "Web" do Google Cloud. Redirect URI autorizada: https://<API_DOMAIN>/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Segredos próprios (gere com os comandos indicados) ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
STATE_SECRET=

# --- Supabase auto-hospedado (docker-compose.yml): guarda os tokens do Notion ---
# python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Chaves JWT HS256 assinadas com o JWT_SECRET (service_role e anon). Veja supabase/gerar_chaves.py
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_URL=http://rest:3000

# --- Opcionais (os padrões já servem; descomente só para mudar) ---
# MAX_IMAGES=20                    # fotos por envio; ajuste também nekonote.maxImagens no mobile
# PROCESSING_LIMIT_PER_HOUR=10     # processamentos por usuário por hora
